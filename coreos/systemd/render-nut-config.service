# NUT's upsd.users/upsmon.conf have no "passwordFile" indirection like the
# NixOS power.ups module provided -- this renders the decrypted password
# from /run/secrets into the real config files at boot, matching what the
# Nix module did at activation time.
#
# Both nut-admin and nut-observer use the SAME /run/secrets/secret1 value
# below -- this isn't a simplification, it's the existing repo's actual
# behavior: modules/hardware/ups.nix sets passwordFile =
# config.age.secrets.secret1.path for both NUT users (and for the Borg
# passphrase too, see borgbackup.service). Preserved as-is for parity
# rather than splitting it, since secret1.age isn't being re-encrypted.
#
# Starts nut-server/nut-monitor itself (last ExecStartPost) rather than
# relying on them being enabled -- see enable-layered-units.service, which
# deliberately does NOT start these two, precisely so they never come up
# with the literal __NUT_ADMIN_PASS__ template placeholder still in place.
# `restart` (not `start`) so re-runs of this unit on later boots also pick
# up any rotated secret.
[Unit]
Description=Render NUT config with decrypted secrets
After=decrypt-secrets.service layer-packages.service
Requires=decrypt-secrets.service layer-packages.service
Before=nut-server.service nut-monitor.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/sh -c '\
  PASS=$(cat /run/secrets/secret1); \
  sed -e "s/__NUT_ADMIN_PASS__/$PASS/" -e "s/__NUT_OBSERVER_PASS__/$PASS/" /etc/nut/upsd.users.tmpl > /etc/nut/upsd.users; \
  sed -e "s/__NUT_ADMIN_PASS__/$PASS/" /etc/nut/upsmon.conf.tmpl > /etc/nut/upsmon.conf \
'
ExecStartPost=/usr/bin/chmod 0640 /etc/nut/upsd.users /etc/nut/upsmon.conf
ExecStartPost=/usr/bin/chown root:nut /etc/nut/upsd.users /etc/nut/upsmon.conf
ExecStartPost=-/usr/bin/systemctl restart nut-server.service nut-monitor.service

[Install]
WantedBy=multi-user.target
