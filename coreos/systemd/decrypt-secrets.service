# Replaces agenix. Decrypts the EXISTING repo secrets (secret1/3/7/8.age,
# unmodified) into tmpfs (/run/secrets) at every boot, using
# /home/sumee/.ssh/id_ed25519 as the age identity -- the same private key
# already deployed for the Borg job (§5 of the plan), which is already an
# authorized agenix recipient for these files (see secrets/agenix-rules.nix:
# secret1/3/8 -> `cute`, secret7 -> `unison`). age natively accepts
# ssh-ed25519 keys for decryption, so no new keypair or re-encryption is
# needed -- this is the exact same key/ciphertext pair the live NixOS box
# already uses, just decrypted with the standalone `age` CLI instead of
# agenix. Gone on reboot/power-loss, matching agenix's runtime-only
# decryption model.
#
# secret1.age is the current repo's single shared value reused for the
# Borg passphrase AND both NUT user passwords (see modules/hardware/ups.nix
# and hosts/verdure/configuration.nix) -- decrypted once here as a raw
# value and referenced three times downstream (borgbackup.service,
# render-nut-config.service), preserving that exact (if slightly odd)
# parity rather than splitting it.
#
# Uses the rpm-ostree-layered `age` package (see layer-packages.service)
# rather than a vendored static binary, so it gets normal security updates
# instead of being frozen at whatever was fetched once. This means this
# unit can't run until after the one-time layering reboot has happened.
[Unit]
Description=Decrypt existing agenix secrets into tmpfs
After=local-fs.target layer-packages.service
Requires=layer-packages.service
Before=hass.service 2fauth.service vaultwarden.service tailscale-up.service borgbackup.service render-nut-config.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/bin/mkdir -p -m 0700 /run/secrets
ExecStart=/usr/bin/age -d -i /home/sumee/.ssh/id_ed25519 -o /run/secrets/secret1       /etc/secrets/secret1.age
ExecStart=/usr/bin/age -d -i /home/sumee/.ssh/id_ed25519 -o /run/secrets/2fauth.env    /etc/secrets/secret3.age
ExecStart=/usr/bin/age -d -i /home/sumee/.ssh/id_ed25519 -o /run/secrets/tailscale.env /etc/secrets/secret7.age
ExecStart=/usr/bin/age -d -i /home/sumee/.ssh/id_ed25519 -o /run/secrets/vaultwarden.env /etc/secrets/secret8.age
ExecStartPost=/usr/bin/sh -c 'chmod 0400 /run/secrets/*'

[Install]
WantedBy=multi-user.target
